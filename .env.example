# Copie para .env.dev (não versionado) e preencha com os dados do seu banco no Neon.
# Execução: docker compose --env-file .env.dev up --build
APP_PORT=8080
DB_URL=jdbc:postgresql://SEU_HOST/SEU_BANCO?sslmode=require
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA
SPRING_PROFILES_ACTIVE=dev

# Para usar o PostgreSQL local opcional (compose.local-db.yaml), troque por:
# DB_URL=jdbc:postgresql://database:5432/cinecookie
# DB_USER=cinecookie
# DB_PASSWORD=cinecookie
